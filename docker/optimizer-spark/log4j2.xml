<!-- Every logger routes by the "logFilePath" MDC key to LOG_DIR/<pid>/{driver,<taskId>}.log. -->
<Configuration monitorInterval="30">
    <Properties>
        <Property name="LOG_DIR">${env:LOG_DIR:-/mnt/amoro-logs/compaction}</Property>
        <!-- info makes the per-task files useful; AMORO_SPARK_LOG_LEVEL=warn quietens them. -->
        <Property name="SPARK_LEVEL">${env:AMORO_SPARK_LOG_LEVEL:-info}</Property>
        <Property name="CONSOLE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS'Z'}{UTC} %-5p [%t] [%c{1}] [P:%X{processId}|T:%X{taskId}] - %m%n</Property>
        <Property name="JSON_LOG_PATTERN">{"level":"%p","time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}{UTC}","processId":"%X{processId}","taskId":"%X{taskId}","thread":"%enc{%t}{JSON}","logger":"%c{1}","message":"%enc{%m}{JSON}","stackTrace":"%enc{%throwable{full}}{JSON}"}%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="${CONSOLE_PATTERN}"/>
        </Console>

        <!-- Events belonging to no compaction; they still reach Console via the root logger. -->
        <Null name="Discard"/>

        <!-- Routing appender: creates per-process/task log files based on MDC logFilePath -->
        <Routing name="RoutingAppender">
            <Routes pattern="$${ctx:logFilePath}">
                <!-- Unset logFilePath leaves the pattern literal, matching this key: no file. -->
                <Route key="$${ctx:logFilePath}" ref="Discard"/>
                <!-- When logFilePath IS set, create a log file -->
                <Route>
                    <RollingFile name="Route-${ctx:logFilePath}"
                                 fileName="${LOG_DIR}/${ctx:logFilePath}.log"
                                 filePattern="${LOG_DIR}/${ctx:logFilePath}-%i.log.gz"
                                 append="true"
                                 createOnDemand="true"
                                 bufferedIO="false"
                                 immediateFlush="true">
                        <PatternLayout pattern="${JSON_LOG_PATTERN}"/>
                        <Policies>
                            <SizeBasedTriggeringPolicy size="100MB"/>
                        </Policies>
                        <DefaultRolloverStrategy max="5"/>
                    </RollingFile>
                </Route>
            </Routes>
            <!-- Close idle files, else a long lived driver holds one descriptor per compaction. -->
            <IdlePurgePolicy timeToLive="15" timeUnit="minutes"/>
        </Routing>
    </Appenders>

    <Loggers>
        <!-- Loggers below only tune levels; they inherit these appenders. -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RoutingAppender"/>
        </Root>

        <Logger name="org.apache.amoro" level="info"/>
        <Logger name="org.apache.amoro.optimizing" level="debug"/>
        <Logger name="org.apache.amoro.optimizer" level="info"/>

        <!-- Spark's own scheduler, executor allocation and task failure lines. -->
        <Logger name="org.apache.spark" level="${SPARK_LEVEL}"/>

        <Logger name="org.apache.hadoop" level="warn"/>
        <Logger name="org.apache.parquet" level="warn"/>
        <Logger name="org.apache.iceberg.avro" level="warn"/>
        <Logger name="org.sparkproject.jetty" level="warn"/>
    </Loggers>
</Configuration>
