{
  "type": "ICEBERG",
  "writer": {
    "catalog_type": "hive",
    "catalog_name": "olake_hive",
    "hive_uri": "thrift://hive-metastore:9083",
    "hive_clients": 5,
    "hive_sasl_enabled": false,
